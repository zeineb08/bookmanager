# ============================================================
# BookManager – terraform.tfvars EXAMPLE (Dev/Staging)
# ============================================================
# SECURITY RULES:
#   1. cp terraform.tfvars.example terraform.tfvars
#   2. Fill in all values marked with REQUIRED
#   3. NEVER commit terraform.tfvars (already in .gitignore)
#   4. Rotate secrets regularly
# ============================================================

# ─── Azure Subscription ──────────────────────────────────────
# REQUIRED — Get these with: az account show
subscription_id = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
tenant_id       = "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ─── Project Settings ────────────────────────────────────────
project_name = "bookmanager"
environment  = "dev"
location     = "francecentral"

# ─── Networking ──────────────────────────────────────────────
vnet_address_space   = "10.0.0.0/16"
app_subnet_prefix    = "10.0.2.0/24"

# ─── Compute ─────────────────────────────────────────────────
# Azure VM sizes guide:
#   Standard_B1s  = 1 vCPU, 1 GB  — ~$8/mo  (very light, dev only)
#   Standard_B2s  = 2 vCPU, 4 GB  — ~$35/mo (recommended)
#   Standard_B2ms = 2 vCPU, 8 GB  — ~$60/mo (if you need more RAM)
vm_size         = "Standard_B2s"
admin_username  = "bookmanager"
os_disk_size_gb = 30

# REQUIRED — Generate SSH key: ssh-keygen -t ed25519 -C "bookmanager-azure"
# Paste the full content of ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... your-email@example.com"

# ─── SSH Access ──────────────────────────────────────────────
# RECOMMENDED — Restrict SSH to your IP for security.
# Find your IP: curl ifconfig.me  (or Invoke-WebRequest ifconfig.me)
# Example: "203.0.113.42/32"
# Leave as "*" to allow SSH from anywhere (dev convenience, less secure)
allowed_ssh_cidr = "*"

# ─── Container Registry ──────────────────────────────────────
acr_sku = "Basic"  # $5/mo — fine for dev

# ─── Application Secrets ─────────────────────────────────────
# REQUIRED — Your MongoDB Atlas connection string
mongodb_uri = "mongodb+srv://username:password@cluster0.xxx.mongodb.net/bookmanager?retryWrites=true&w=majority"

# REQUIRED — Generate: openssl rand -hex 64  (use WSL or Git Bash)
jwt_secret = "replace_with_openssl_rand_output_64_hex_chars_minimum"

# ─── Docker Hub ───────────────────────────────────────────────
# REQUIRED — your Docker Hub username
dockerhub_username = "your_dockerhub_username"
image_tag          = "latest"

# ─── Storage ─────────────────────────────────────────────────
storage_replication = "LRS"  # 3 copies, same datacenter — cheapest

# ─── Monitoring ──────────────────────────────────────────────
log_retention_days = 30           # First 5 GB/month is free
alert_email        = "your-email@example.com"

# ─── Resource Tags ───────────────────────────────────────────
common_tags = {
  Project     = "bookmanager"
  ManagedBy   = "Terraform"
  Environment = "dev"
  Owner       = "DevOps"
  CostCenter  = "Engineering"
}
